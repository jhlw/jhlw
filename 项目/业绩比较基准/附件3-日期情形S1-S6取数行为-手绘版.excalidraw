    {
      "id": "text-26",
      "type": "text",
      "x": 42,
      "y": 363.75,
      "width": 446,
      "height": 87.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
